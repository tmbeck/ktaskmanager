#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Make the panel's right-click menu offer "Task Manager" (or put the stock menu back with --disable).
set -e
rc=~/.config/plasma-org.kde.plasma.desktop-appletsrc
key="RightButton;NoModifier"
want=org.kde.ktaskmanagermenu
[ "$1" = --disable ] && want=org.kde.contextmenu
if [ "$(kreadconfig6 --file "$rc" --group ActionPlugins --group 1 --key "$key")" != "$want" ]; then
    # plasmashell rewrites its config on exit, so edit while it's stopped. [ActionPlugins][1] = panels.
    running=$(systemctl --user is-active -q plasma-plasmashell 2>/dev/null && echo 1 || true)
    [ -z "$running" ] || systemctl --user stop plasma-plasmashell
    kwriteconfig6 --file "$rc" --group ActionPlugins --group 1 --key "$key" "$want"
    [ -z "$running" ] || systemctl --user start plasma-plasmashell
fi
echo "Panel right-click menu: $want"
